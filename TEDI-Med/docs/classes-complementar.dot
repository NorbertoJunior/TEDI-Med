digraph G {
graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.35, ranksep=.65, labelloc=t, label="TEDI Med — Terminal e testes", fontsize=22, fontname="DejaVu Sans"];
node [shape=plain,fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans",fontsize=10,color="#334155"];
MainTerminal [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#234B65"><TR><TD BGCOLOR="#DCEAF4"><FONT POINT-SIZE="10">br.edu.tedi</FONT><BR/><B>MainTerminal</B></TD></TR><TR><TD ALIGN="LEFT">- entrada: Scanner {readOnly}<BR ALIGN="LEFT"/>- servico: MedicamentoService {readOnly}<BR ALIGN="LEFT"/>- lembretes: LembreteService {readOnly}<BR ALIGN="LEFT"/>- FORMATO: DateTimeFormatter {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">- texto(pergunta: String): String<BR ALIGN="LEFT"/>- numero(pergunta: String): int<BR ALIGN="LEFT"/>- horario(): LocalTime<BR ALIGN="LEFT"/>- exibir(lista: List&lt;Medicamento&gt;): void<BR ALIGN="LEFT"/>- cadastrar(): void<BR ALIGN="LEFT"/>- editar(): void<BR ALIGN="LEFT"/>+ main(args: String[]): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TesteTEDIMed [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#234B65"><TR><TD BGCOLOR="#DCEAF4"><FONT POINT-SIZE="10">br.edu.tedi</FONT><BR/><B>TesteTEDIMed</B></TD></TR><TR><TD ALIGN="LEFT">- verificar(condicao: boolean, descricao: String): void<BR ALIGN="LEFT"/>+ main(args: String[]): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MedicamentoService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#234B65"><TR><TD BGCOLOR="#DCEAF4"><FONT POINT-SIZE="10">br.edu.tedi.service</FONT><BR/><B>MedicamentoService</B></TD></TR><TR><TD ALIGN="LEFT">- medicamentos: List&lt;Medicamento&gt; {readOnly}<BR ALIGN="LEFT"/>- proximoId: int = 1<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ cadastrar(nome: String, dosagem: String, horario: LocalTime, orientacoes: String): Medicamento<BR ALIGN="LEFT"/>+ listar(): List&lt;Medicamento&gt;<BR ALIGN="LEFT"/>+ buscarPorId(id: int): Medicamento<BR ALIGN="LEFT"/>+ buscarPorNome(termo: String): List&lt;Medicamento&gt;<BR ALIGN="LEFT"/>+ editar(id: int, nome: String, dosagem: String, horario: LocalTime, orientacoes: String): boolean<BR ALIGN="LEFT"/>+ excluir(id: int): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
LembreteService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#234B65"><TR><TD BGCOLOR="#DCEAF4"><FONT POINT-SIZE="10">br.edu.tedi.service</FONT><BR/><B>LembreteService</B></TD></TR><TR><TD ALIGN="LEFT">- medicamentos: MedicamentoService {readOnly}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ LembreteService(medicamentos: MedicamentoService)<BR ALIGN="LEFT"/>+ consultarPorHorario(horario: LocalTime): List&lt;Medicamento&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Medicamento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#234B65"><TR><TD BGCOLOR="#DCEAF4"><FONT POINT-SIZE="10">br.edu.tedi.model</FONT><BR/><B>Medicamento</B></TD></TR><TR><TD ALIGN="LEFT">- id: int {readOnly}<BR ALIGN="LEFT"/>- nome: String<BR ALIGN="LEFT"/>- dosagem: String<BR ALIGN="LEFT"/>- orientacoes: String<BR ALIGN="LEFT"/>- horario: LocalTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ Medicamento(id: int, nome: String, dosagem: String, horario: LocalTime, orientacoes: String)<BR ALIGN="LEFT"/>- obrigatorio(texto: String): String<BR ALIGN="LEFT"/>+ getId(): int<BR ALIGN="LEFT"/>+ getNome(): String<BR ALIGN="LEFT"/>+ getDosagem(): String<BR ALIGN="LEFT"/>+ getHorario(): LocalTime<BR ALIGN="LEFT"/>+ getOrientacoes(): String<BR ALIGN="LEFT"/>+ setNome(nome: String): void<BR ALIGN="LEFT"/>+ setDosagem(dosagem: String): void<BR ALIGN="LEFT"/>+ setHorario(horario: LocalTime): void<BR ALIGN="LEFT"/>+ setOrientacoes(orientacoes: String): void<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
